{
  "stryker-config": {
    "project": "Nealytics.Engine.csproj",
    "test-projects": [
      "../../tests/Nealytics.Engine.Tests.Unit/Nealytics.Engine.Tests.Unit.csproj",
      "../../tests/Nealytics.Engine.Tests.Integration/Nealytics.Engine.Tests.Integration.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~ClickHousePoolLifecycle|FullyQualifiedName~ClickHousePoolTests|FullyQualifiedName~ClickHouseWorkloadCapacityTests|FullyQualifiedName~ClickHouseCapacityOptionsTests|FullyQualifiedName~ConnectionIdleRecycleTests",
