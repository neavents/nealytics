{
  "stryker-config": {
    "project": "Nealytics.Engine.csproj",
    "test-projects": [
      "../../tests/Nealytics.Engine.Tests.Unit/Nealytics.Engine.Tests.Unit.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~SourceMapping|FullyQualifiedName~SourceRecordMapping|FullyQualifiedName~Kafka|FullyQualifiedName~Ndjson",
