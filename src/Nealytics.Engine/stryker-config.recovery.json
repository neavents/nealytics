{
  "stryker-config": {
    "project": "Nealytics.Engine.csproj",
    "test-projects": [
      "../../tests/Nealytics.Engine.Tests.Unit/Nealytics.Engine.Tests.Unit.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~WalReplayReaderTests|FullyQualifiedName~StreamingRecoveryTests|FullyQualifiedName~WriteAheadLoggerTests|FullyQualifiedName~TelemetryBatchProcessorTests|FullyQualifiedName~WalDirectoryTests|FullyQualifiedName~WalSegmentRecoveryTests",
    "mutate": [
      "Infrastructure/Storage/Wal/WalReplayReader.cs",
      "Infrastructure/Storage/Wal/WalReplayRecord.cs",
      "Infrastructure/Storage/WriteAheadLogger.Recovery.cs",
      "Features/BatchProcessor/TelemetryBatchProcessor.cs",
      "Features/BatchProcessor/TelemetryBatchProcessor.Recovery.cs"
    ],
    "mutation-level": "Complete",
    "concurrency": 2,
    "break-on-initial-test-failure": true,
    "reporters": [
      "dots",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    }
  }
}
