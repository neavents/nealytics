{
  "stryker-config": {
    "project": "Nealytics.Engine.csproj",
    "test-projects": [
      "../../tests/Nealytics.Engine.Tests.Unit/Nealytics.Engine.Tests.Unit.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~Kafka",
    "mutate": [
      "Features/KafkaIngestion/*.cs",
      "Infrastructure/Configuration/KafkaConnectorOptions.cs",
      "Program.cs{15402..15465}",
      "Infrastructure/Configuration/TelemetryEngineOptions.cs{7052..7105}",
      "Program.cs{18429..18503}"
    ],
    "mutation-level": "Complete",
    "concurrency": 2,
    "break-on-initial-test-failure": true,
    "reporters": [
      "dots",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    }
  }
}
