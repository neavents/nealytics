<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      One self contained binary, no runtime needed on the host. Not compiled ahead of time: the
      ClickHouse client builds its column writers reflectively, which an ahead of time build cannot
      see, and every published release before v2 accepted events and stored none of them because of
      it. See the release notes.
    -->
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!--
      The JSON surface is source generated through
      TelemetryAotContext and nothing here relies on reflection-based serialization; leaving this
      false keeps it that way and keeps the trimmed size down.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!--
      InvariantGlobalization stays true. The engine deliberately holds no
      culture-sensitive text handling, parses with InvariantCulture explicitly, and leaves Turkish
      casing to the producer, which has full ICU. Flipping it would add ~30 MB of ICU data for
      behaviour nothing here asks for.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Nealytics.Engine</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Octonica.ClickHouseClient" Version="4.1.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nealytics.Engine.Tests.Unit" />
    <InternalsVisibleTo Include="Nealytics.Engine.Tests.Integration" />
  </ItemGroup>

</Project>
