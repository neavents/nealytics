      "../../tests/Nealytics.Engine.Tests.Integration/Nealytics.Engine.Tests.Integration.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~NamedMetric|FullyQualifiedName~SavedReport|FullyQualifiedName~ComputedDimension",
