      "Program.cs{2848..2975}",
      "Program.cs{9777..9827}",
      "Program.cs{12478..12502}",
      "Features/GetSchema/GetSchemaEndpoint.cs{5384..5421}",
      "Features/GetSchema/SchemaResponse.cs{3065..3256}",
      "Infrastructure/Query/MetricAggregateSql.cs",
      "Infrastructure/Configuration/MetricExpression.cs",
      "Infrastructure/Configuration/MetricFormulaCompiler.cs",
      "Infrastructure/Query/FormulaNode.cs",
      "Infrastructure/Query/FormulaNumber.cs",
      "Infrastructure/Query/MetricProjection.cs",
      "Infrastructure/Query/MetricProjectionSql.cs",
