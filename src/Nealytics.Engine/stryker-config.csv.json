      "low": 100,
      "break": 100
    },
    "mutate": [
      "Features/ImportCsv/*.cs",
      "Features/SourceMapping/SourceValues.cs",
      "Features/SourceMapping/SourceRecordMapping.cs",
      "Program.cs{10586..11027}",
      "Program.cs{11207..11375}",
      "Program.cs{17766..17825}",
      "Infrastructure/Configuration/TelemetryEngineOptions.cs{7107..7243}"
    ]
  }
}
