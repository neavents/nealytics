{
  "stryker-config": {
    "project": "Nealytics.Engine.csproj",
    "test-projects": [
      "../../tests/Nealytics.Engine.Tests.Unit/Nealytics.Engine.Tests.Unit.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~Csv|FullyQualifiedName~SourceMapping|FullyQualifiedName~SourceRecordMapping|FullyQualifiedName~Ndjson|FullyQualifiedName~Kafka",
    "mutation-level": "Complete",
    "concurrency": 4,
    "break-on-initial-test-failure": true,
    "reporters": [
      "dots",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "mutate": [
      "Features/ImportCsv/*.cs",
      "Features/SourceMapping/SourceValues.cs",
      "Features/SourceMapping/SourceRecordMapping.cs",
      "Program.cs{10673..11114}",
      "Program.cs{11294..11462}",
      "Program.cs{18369..18428}",
      "Infrastructure/Configuration/TelemetryEngineOptions.cs{7107..7243}"
    ]
  }
}
